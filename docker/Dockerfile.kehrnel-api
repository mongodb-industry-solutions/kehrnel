# Kehrnel API with the vendored FHIR runtime libraries.
FROM python:3.14.6-slim
WORKDIR /kehrnel
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir \
      -e ./src/kehrnel/engine/domains/fhir/libs/fhir-data-generation \
      -e ./src/kehrnel/engine/domains/fhir/libs/fhir-search-to-mql \
    && pip install --no-cache-dir -e ".[api,mongo,cdisc,cdisc-cloud,fhir]"
ENV KEHRNEL_API_PORT=8080
ENV KEHRNEL_API_RELOAD=false
EXPOSE 8080
CMD ["kehrnel-api"]
