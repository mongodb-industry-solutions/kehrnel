# Build-context rules for demo/wetty/shell/Dockerfile only. The root
# .dockerignore is tuned for the production image and excludes demo/,
# examples/, samples/ and startKehrnel, all of which this image copies.
.git
.github
**/.venv
**/.venv-*
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/node_modules
docs/website/build
docs/website/.docusaurus
.kehrnel
.kehrnel_registry.json
*.pem
**/.env
**/.env.*
