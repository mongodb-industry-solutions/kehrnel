  "placementGuide": [
    {
      "family": "All imaging",
      "embedded": "Identity, modality/SOP Class summary, validated technical groups, SOP/frame counts, inventory/header coverage and revision",
      "outside": "Original bytes, full headers, detailed per-instance/frame geometry and retrieval offsets",
      "adapter": "SOP Class determines frame and content semantics; modality alone is insufficient"
    },
    {
      "family": "CT",
      "embedded": "Bounded reconstruction/acquisition groups: kernel, thickness, acquisition protocol, equipment and contrast evidence when available",
      "outside": "Per-frame geometry, per-event dose, large reconstruction groups",
      "adapter": "Classic and enhanced CT; shared/per-frame functional groups require dedicated frame contracts"
    },
    {
      "family": "MR",
      "embedded": "Bounded observed acquisition tuples: TR/TE, sequence, echo and diffusion parameters when their scope is known",
      "outside": "Per-frame diffusion/dynamic/echo geometry and full spectroscopy data",
      "adapter": "Classic/enhanced MR and spectroscopy are different objects; generic root-tag profiles are incomplete"
    },
    {
      "family": "MG / DX / CR",
      "embedded": "Laterality/view groups, equipment and image-versus-frame counts",
      "outside": "Tomosynthesis frame positions, presentation details, dose measurement trees",
      "adapter": "Presentation/processing/3D SOP Classes and functional-group anatomy must be distinguished"
    },
    {
      "family": "US / XA / RF",
      "embedded": "Acquisition/encoding summaries and bounded region/sequence metadata",
      "outside": "Cine frame timeline, region calibration, waveforms and frame geometry",
      "adapter": "Region/temporal context is required before interpreting measurements"
    },
    {
      "family": "PT / NM",
      "embedded": "Acquisition groups, units and correction status when explicitly supported",
      "outside": "Radiopharmaceutical timing/activity and dynamic frame details",
      "adapter": "Quantitative interpretation requires units, decay correction, timing and calibrated algorithms"
    },
    {
      "family": "SM whole slide",
      "embedded": "Specimen identity references, total matrix, optical path and resolution summaries",
      "outside": "Tile/frame geometry, optical-path details and large specimen/annotation trees",
      "adapter": "Sparse tiles, pyramids and specimen context are not a flat image series"
    },
    {
      "family": "SR / SEG / PR / RT / ANN",
      "embedded": "Object kinds, template/label summaries and bounded reference availability",
      "outside": "Concept/value/unit/target items, segment definitions, contours, dose grids and annotations",
      "adapter": "References describe another object; storage membership is not clinical target identity"
    }
  ]
}
