{
  "type": "object",
  "properties": {
    "database": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 63
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 64
    },
    "allowed_centers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "collections": {
      "type": "object",
      "properties": {
        "studies": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 120
        },
        "series": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 120
        },
        "instances": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 120
        },
        "research": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 120
        }
      },
      "required": [
        "studies",
        "series",
        "instances",
        "research"
      ],
      "additionalProperties": false
    },
    "headers": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "inline",
            "bundle"
          ]
        },
        "bundle_max_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 8388608
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 16777216,
          "description": "BSON byte bound for the complete bounded header-batch result."
        }
      },
      "required": [
        "mode",
        "bundle_max_bytes"
      ],
      "additionalProperties": false
    },
    "ingest": {
      "type": "object",
      "properties": {
        "max_documents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 15728640
        },
        "max_series_per_study": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "write_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "max_documents",
        "max_bytes",
        "max_series_per_study",
        "write_concurrency"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "default_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "default_limit",
        "max_limit"
      ],
      "additionalProperties": false
    },
    "projections": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "pattern": "^[0-9A-F]{8}$"
              },
              "type": {
                "enum": [
                  "string",
                  "number"
                ]
              }
            },
            "required": [
              "tag",
              "type"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,16}$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "max_values_per_instance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "search_enabled": {
          "type": "boolean"
        },
        "search_index": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "refresh_on_ingest": {
          "type": "boolean",
          "description": "Default false: research promotion is a separate background build."
        }
      },
      "required": [
        "enabled",
        "tags",
        "modalities",
        "max_values_per_instance",
        "search_enabled",
        "search_index",
        "refresh_on_ingest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "database",
    "tenant_id",
    "allowed_centers",
    "collections",
    "headers",
    "ingest",
    "query",
    "projections"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
