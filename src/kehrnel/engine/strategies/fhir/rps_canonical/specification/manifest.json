{
  "id": "fhir.rps_canonical",
  "name": "FHIR RPS Canonical",
  "version": "0.1.0",
  "maturity": "beta",
  "pack_format": "strategy-pack/v1",
  "spec": { "path": "spec.json", "version": "1.0" },
  "domain": "FHIR",
  "summary": "Native FHIR R5 storage with fhir-gen synthetic data and fhir-mql search translation.",
  "description": "Stores canonical FHIR resources in per-type MongoDB collections, generates synthetic corpora via fhir-gen, and executes FHIR search parameters through fhir-mql denormalized indexes.",
  "config": {
    "strategy": {
      "schema": "schema.json",
      "defaults": "defaults.json",
      "description": "FHIR database, generation, and search configuration"
    }
  },
  "capabilities": ["ingest", "query", "search", "synthetic", "validate"],
  "entrypoint": "kehrnel.engine.strategies.fhir.rps_canonical.strategy:FHIRRPSCanonicalStrategy",
  "ui": {
    "tags": ["FHIR", "synthetic", "search", "fhir-mql", "fhir-gen"],
    "domain_badge": "FHIR",
    "docs": "/guide/docs/strategies/fhir/rps-canonical"
  },
  "ops": [
    {
      "name": "synthetic_generate_batch",
      "kind": "synthetic",
      "summary": "Generate FHIR resources in batch via fhir-gen",
      "input_schema": { "type": "object", "additionalProperties": true },
      "output_schema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "fhir_denormalize",
      "kind": "maintenance",
      "summary": "Build _search denormalized fields for FHIR search",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_types": { "type": "array", "items": { "type": "string" } },
          "dry_run": { "type": "boolean" }
        }
      },
      "output_schema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "fhir_ensure_indexes",
      "kind": "maintenance",
      "summary": "Ensure MongoDB indexes for FHIR search fields",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_types": { "type": "array", "items": { "type": "string" } },
          "dry_run": { "type": "boolean" }
        }
      },
      "output_schema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "fhir_search",
      "kind": "query",
      "summary": "Compile and execute FHIR search criteria",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_type": { "type": "string" },
          "criteria": { "type": "object", "additionalProperties": true },
          "fhir_search": { "type": "string" },
          "explain_only": { "type": "boolean" },
          "limit": { "type": "integer", "minimum": 1 },
          "_count": { "type": "integer", "minimum": 1 },
          "_offset": { "type": "integer", "minimum": 0 },
          "compartment": { "type": "object" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "rows": { "type": "array" },
          "total": { "type": "integer" },
          "plan": { "type": "object" },
          "explain": { "type": "object" },
          "explain_only": { "type": "boolean" }
        }
      }
    },
    {
      "name": "fhir_list_search_params",
      "kind": "query",
      "summary": "List supported FHIR search parameters for a resource type",
      "input_schema": {
        "type": "object",
        "required": ["resource_type"],
        "properties": {
          "resource_type": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "resource_type": { "type": "string" },
          "parameter_count": { "type": "integer" },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "modifiers": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    {
      "name": "fhir_stats",
      "kind": "diagnostic",
      "summary": "Collection counts and denormalization coverage",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_types": { "type": "array", "items": { "type": "string" } }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "database": { "type": "string" },
          "collections": { "type": "array" },
          "indexed_resource_types": { "type": "array", "items": { "type": "string" } },
          "gaps": { "type": "object" }
        }
      }
    },
    {
      "name": "negotiate_fhir_search",
      "kind": "extension",
      "summary": "Natural-language draft to validated FHIR search criteria",
      "input_schema": { "type": "object", "additionalProperties": true },
      "output_schema": { "type": "object", "additionalProperties": true }
    }
  ],
  "adapters": {
    "storage": ["mongo"]
  }
}

