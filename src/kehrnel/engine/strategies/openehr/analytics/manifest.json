  "ui": {
    "activatable": true,
    "domain_badge": "openEHR",
    "docs": "/guide/docs/openehr-analytics-strategy",
    "tags": [
      "openEHR",
      "analytics"
    ],
    "constraints": [
      "Use a separate analytics environment; the operational AQL activation remains independent.",
      "Transactions require a replica set or sharded MongoDB deployment.",
      "Real-source compatibility and billion-composition throughput require deployment qualification.",
      "This pack ingests analytics documents; it does not implement an AQL or SQL query compiler."
    ],
    "status_message": "Published for configuration and activation. Validate source compatibility, query performance and throughput on the target deployment before production rollout.",
    "story": "Clinical analytics needs meaningful variables without navigating an entire openEHR composition. This strategy projects reviewed clinical blocks into independent fact documents, retaining related values and small nested objects together. A blood-pressure reading keeps systolic and diastolic in the same fact.\n\nThe activity collection represents the current version of each composition, with its hospital, patient, template and time. Patient snapshots and shared provenance live in separate collections. The original CDR remains the source of record.\n\nOfficial source strategies can supply canonical compositions through their retrieval or reverse-transform interfaces. For example, openEHR RPS Dual can reconstruct a composition before analytics rules are applied. Source-specific adapters are selected in the environment configuration.",
    "how_it_works": "1. Choose a separate analytics database and a stable source identifier.\n\n2. Add exact OPTs in Data Model Catalog. In each Analytics tab, review the proposed fact blocks, select fields, set supported conversions and retention, then validate and preview one composition.\n\n3. Save a draft and approve a release. Integration clients download approved configuration through the environment developer-key API.\n\n4. The same Python converter supports historical batches and new compositions. Publication replaces the previous composition output atomically and updates daily activity counts. Missing rules or uncovered clinical content hold facts for review.",
    "benefits": [
      "Related measurements stay together; typed values can retain nested JSON and arrays.",
      "Explicit business-variable reuse supports approved cross-template analysis.",
      "Shared source references avoid repeating complete paths and provenance in every fact.",
      "One conversion path supports backfill, incremental ingestion and versioned rule changes."
    ],
    "ideal_for": [
      "Clinical fact analysis across mapped templates, composition activity and patient cohorts.",
      "A separate analytics environment with governed template rules and an external ingestion worker."
    ],
    "consider_alternatives": [
      "Keep full AQL and canonical retrieval in the operational CDR.",
      "Validate index plans, patient feeds, rule coverage and throughput against the intended deployment. Atlas Search and vectors are not provisioned by this strategy pack."
    ]
  },
  "distribution": "official"
}
