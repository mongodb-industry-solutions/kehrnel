{
  "id": "openehr.analytics",
  "name": "openEHR Analytical Facts",
  "version": "0.1.0",
  "domain": "openEHR",
  "maturity": "published",
  "pack_format": "strategy-pack/v1",
  "spec": {
    "path": "spec.json",
    "version": "1.0"
  },
  "summary": "Versioned clinical facts, composition activity and lineage from openEHR compositions through configured source adapters.",
  "entrypoint": "kehrnel.engine.strategies.openehr.analytics.strategy:OpenEHRAnalyticsStrategy",
  "config": {
    "strategy": {
      "schema": "schema.json",
      "defaults": "defaults.json",
      "description": "Reviewed clinical block rules and analytics destination"
    }
  },
  "capabilities": [
    "transform",
    "ingest",
    "plan",
    "apply"
  ],
  "adapters": {
    "storage": [
      "mongodb"
    ],
    "search": [],
    "vector": [],
    "queue": []
  },
  "compatibility": {
    "packFormat": "strategy-pack/v1",
    "requires": [
      "storage.mongo"
    ],
    "optional": []
  },
  "ops": [
    {
      "name": "analytics_source_from_strategy",
      "kind": "utility",
      "summary": "Resolve a portable read profile from an operational source environment without activation",
      "input_schema": {
        "type": "object",
        "properties": {
          "environment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,63}$"
          },
          "strategy_id": {
            "enum": [
              "openehr.rps_dual",
              "openehr.rps_dual_ibm"
            ]
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "environment_id",
          "database",
          "strategy_id",
          "config"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "analytics_preview",
      "kind": "transform",
      "summary": "Preview one composition through the configured source adapter without writing",
      "input_schema": {
        "type": "object",
        "required": [
          "document",
          "accepted_at"
        ],
        "properties": {
          "document": {
            "type": "object"
          },
          "accepted_at": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "analytics_ingest",
      "kind": "ingest",
      "summary": "Atomically publish one versioned composition using reviewed rules",
      "input_schema": {
        "type": "object",
        "required": [
          "document",
          "accepted_at"
        ],
        "properties": {
          "document": {
            "type": "object"
          },
          "accepted_at": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "analytics_rules",
      "kind": "query",
      "summary": "Inspect immutable rule revisions and their activation times",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "analytics_coverage",
      "kind": "query",
      "summary": "Read a bounded page of compositions awaiting template rules",
      "input_schema": {
        "type": "object",
        "properties": {
          "after": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      }
