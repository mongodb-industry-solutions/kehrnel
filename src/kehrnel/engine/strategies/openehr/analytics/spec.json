          "badges": [
            "support"
          ]
        },
        {
          "id": "streams",
          "store": "streams",
          "label": "analytics_streams",
          "description": "Incremental resume tokens and leases",
          "fields": [],
          "links": [],
          "badges": [
            "support"
          ]
        }
      ]
    },
    "architecture": {
      "inputs": [
        {
          "title": "Compositions",
          "body": "Canonical openEHR JSON, supplied directly or reconstructed by the configured source strategy."
        },
        {
          "title": "Reviewed OPT rules",
          "body": "Fact boundaries, selected fields, conversions, effective dates and retention."
        },
        {
          "title": "Patient feed",
          "body": "Separately governed demographic and population snapshots."
        }
      ],
      "processor": {
        "title": "Decode → validate → project",
        "body": "One deterministic conversion path for historical batches and new compositions."
      },
      "relationships": [
        "facts.context.composition_id → activity._id",
        "facts.context.patient_id → patients._id",
        "facts.lineage.source_ref → source_refs._id",
        "source_refs.rule_revision → rule_revisions._id"
      ],
      "notes": [
        "One activity document represents a composition, not necessarily a hospital admission.",
        "One fact represents a reviewed clinical block instance. Related values remain together inside clinical.",
        "Detailed lineage is shared through source_refs. Empty quality objects are omitted.",
        "The shown names use the default analytics_ prefix. Patient payload fields depend on the governed patient feed."
      ],
      "entryProfiles": [
        {
          "type": "OBSERVATION",
          "grain": "Usually one EVENT. Keep systolic and diastolic together; a reviewed repeated CLUSTER can define a finer block."
        },
        {
          "type": "EVALUATION",
          "grain": "One recorded assessment, or a reviewed repeated clinical block."
        },
        {
          "type": "ACTION",
          "grain": "One performed action instance with its time and state."
        },
        {
          "type": "INSTRUCTION",
          "grain": "One planned ACTIVITY; it does not mean the action happened."
        },
        {
          "type": "ADMIN_ENTRY",
          "grain": "One administrative entry, or a reviewed repeated block."
        }
      ]
    }
  }
}
