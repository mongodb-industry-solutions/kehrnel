{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SNOMED CT on MongoDB Strategy Configuration",
  "description": "Canonical SNOMED CT concept storage plus optional term sidecar search collection.",
  "type": "object",
  "properties": {
    "database": {
      "type": "string",
      "description": "Logical MongoDB database name. The actual database is supplied by activation bindings."
    },
    "release": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "description": "Local location where the customer places the licensed official SNOMED CT JSON release.",
      "properties": {
        "local_dir": { "type": "string" },
        "file_name": { "type": "string" },
        "file_pattern": { "type": "string" }
      },
      "additionalProperties": false
    },
    "collections": {
      "type": "object",
      "properties": {
        "concepts": { "type": "string" },
        "terms": { "type": "string" },
        "value_sets": { "type": "string" },
        "grounding_reviews": { "type": "string" },
        "gold_notes": { "type": "string" },
        "usage_events": { "type": "string" },
        "sidecar_enabled": { "type": "boolean" }
      },
      "required": ["concepts", "terms", "value_sets", "grounding_reviews", "sidecar_enabled"],
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "ingest": {
      "type": "object",
      "properties": {
        "batch_size": { "type": "integer", "minimum": 1 },
        "include_descendants": { "type": "boolean" },
        "drop_before_ingest": { "type": "boolean" },
        "rebuild_sidecar": { "type": "boolean" },
        "create_indexes_before_ingest": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "indexes": {
      "type": "object",
      "description": "Index families managed by snomed_ensure_indexes.",
      "properties": {
        "canonical": { "type": "boolean" },
        "sidecar": { "type": "boolean" },
        "text": { "type": "boolean" },
        "atlas_search": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "default_limit": { "type": "integer", "minimum": 1 },
        "max_limit": { "type": "integer", "minimum": 1 },
        "default_language": { "type": "string" },
        "use_sidecar": { "type": "boolean" },
        "lexical_strategy": { "type": "string", "enum": ["normalized_regex"] },
        "scope_max_ids": { "type": "integer", "minimum": 100, "maximum": 250000 },
        "scope_cache_ttl_seconds": { "type": "integer", "minimum": 10 },
        "scope_cache_max_entries": { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "description": "Optional vector branch and rank-fusion tuning. Lexical retrieval never depends on these.",
      "properties": {
        "vector_index": { "type": "string" },
        "vector_path": { "type": "string" },
        "candidate_pool": { "type": "integer", "minimum": 5, "maximum": 200 },
        "rrf_k": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "rerank_pool": { "type": "integer", "minimum": 5, "maximum": 200 }
      },
      "additionalProperties": false
    },
    "clinical": {
      "type": "object",
      "description": "Bounds for clinical note mapping.",
      "properties": {
        "max_phrases": { "type": "integer", "minimum": 1, "maximum": 40 },
        "per_phrase_limit": { "type": "integer", "minimum": 1, "maximum": 25 },
        "llm_extraction": { "type": "boolean" },
        "accept_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "grounding": {
      "type": "object",
      "description": "Governance controls for reviewer-confirmed clinical grounding artifacts.",
      "properties": {
        "store_source_text": { "type": "boolean", "default": false },
        "max_codings_per_review": { "type": "integer", "minimum": 1, "maximum": 250 }
      },
      "additionalProperties": false
    }
  },
  "required": ["database", "release", "collections", "languages"],
  "additionalProperties": false
}
