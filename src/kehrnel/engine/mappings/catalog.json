          {"leftStructure": "encounter", "leftPath": "encounter_id", "rightStructure": "obs", "rightPath": "encounter_id", "cardinality": "one_to_many"},
          {"leftStructure": "obs", "leftPath": "concept_id", "rightStructure": "concept_name", "rightPath": "concept_id", "cardinality": "many_to_one"},
          {"leftStructure": "obs", "leftPath": "concept_id", "rightStructure": "concept_numeric", "rightPath": "concept_id", "cardinality": "many_to_one"}
        ]
      },
