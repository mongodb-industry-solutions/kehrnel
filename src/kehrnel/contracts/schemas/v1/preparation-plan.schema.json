{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BlueprintRevisionRef": {
      "additionalProperties": false,
      "properties": {
        "blueprintId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Blueprintid",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "blueprintId",
        "revision",
        "digest"
      ],
      "title": "BlueprintRevisionRef",
      "type": "object"
    },
    "CompilationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CompilationIssue",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "review",
        "blocking"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "PreparationStage": {
      "additionalProperties": false,
      "properties": {
        "bindingRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Bindingrefs",
          "type": "array"
        },
        "compositionId": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compositionid"
        },
        "failureBehavior": {
          "minLength": 1,
          "title": "Failurebehavior",
          "type": "string"
        },
        "freshnessTargetSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshnesstargetseconds"
        },
        "inputResources": {
          "items": {
            "type": "string"
          },
          "title": "Inputresources",
          "type": "array"
        },
        "interactionIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Interactionids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/PreparationStageKind"
        },
        "outputResources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Outputresources",
          "type": "array"
        },
        "stageId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Stageid",
          "type": "string"
        },
        "strategyInstanceId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Strategyinstanceid",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/PreparationTrigger"
        }
      },
      "required": [
        "stageId",
        "kind",
        "trigger",
        "strategyInstanceId",
        "interactionIds",
        "outputResources",
        "failureBehavior"
      ],
      "title": "PreparationStage",
      "type": "object"
    },
    "PreparationStageKind": {
      "enum": [
        "validate",
        "map",
        "enrich",
        "compose",
        "authoritative_write",
        "materialize",
        "index",
        "rebuild"
      ],
      "title": "PreparationStageKind",
      "type": "string"
    },
    "PreparationTrigger": {
      "enum": [
        "synchronous_write",
        "asynchronous_event",
        "batch"
      ],
      "title": "PreparationTrigger",
      "type": "string"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:preparation-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "blueprintRef": {
      "$ref": "#/$defs/BlueprintRevisionRef"
    },
    "contract": {
      "const": "preparation-plan/v1",
      "title": "Contract",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/CompilationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/PreparationStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "targetCapabilityProfileRef": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "contract",
    "artifactRef",
    "blueprintRef",
    "targetCapabilityProfileRef"
  ],
  "title": "PreparationPlan",
  "type": "object"
}
