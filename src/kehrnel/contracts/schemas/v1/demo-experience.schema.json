{
  "$defs": {
    "ArtifactProvenance": {
      "description": "Who owns the lifecycle of a reusable catalog artifact.",
      "enum": [
        "mongodb_curated",
        "community",
        "tenant_generated",
        "tenant_extended"
      ],
      "title": "ArtifactProvenance",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CapabilityMaturity": {
      "enum": [
        "not_assessed",
        "specified",
        "simulated",
        "compilable",
        "pilot_validated",
        "production_validated"
      ],
      "title": "CapabilityMaturity",
      "type": "string"
    },
    "CatalogArtifactRole": {
      "description": "The architectural role an artifact plays, independent of its industry.",
      "enum": [
        "source_category",
        "source_profile",
        "mapping",
        "target_strategy",
        "semantic_asset",
        "data_architecture",
        "application",
        "outcome_pattern",
        "reference_architecture",
        "demo_experience",
        "portfolio_domain",
        "data_product",
        "architecture_capability",
        "visual_pattern",
        "solution_blueprint_template"
      ],
      "title": "CatalogArtifactRole",
      "type": "string"
    },
    "CatalogMetadata": {
      "additionalProperties": false,
      "description": "Faceted catalog metadata kept separate from executable behavior.",
      "properties": {
        "extendsRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/CatalogPath"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactProvenance"
        },
        "role": {
          "$ref": "#/$defs/CatalogArtifactRole"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "role",
        "provenance",
        "paths"
      ],
      "title": "CatalogMetadata",
      "type": "object"
    },
    "CatalogPath": {
      "additionalProperties": false,
      "description": "One navigational placement; artifacts may appear in several industries.",
      "properties": {
        "industry": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Industry",
          "type": "string"
        },
        "segments": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "industry",
        "segments"
      ],
      "title": "CatalogPath",
      "type": "object"
    },
    "DemoStoryboardStep": {
      "additionalProperties": false,
      "properties": {
        "actorAction": {
          "minLength": 1,
          "title": "Actoraction",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "stepId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Stepid",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visibleResult": {
          "minLength": 1,
          "title": "Visibleresult",
          "type": "string"
        }
      },
      "required": [
        "stepId",
        "title",
        "actorAction",
        "visibleResult"
      ],
      "title": "DemoStoryboardStep",
      "type": "object"
    },
    "PublicationStatus": {
      "enum": [
        "draft",
        "in_review",
        "published",
        "withdrawn"
      ],
      "title": "PublicationStatus",
      "type": "string"
    },
    "SupportStatus": {
      "enum": [
        "unsupported",
        "evaluation_only",
        "supported",
        "deprecated"
      ],
      "title": "SupportStatus",
      "type": "string"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:demo-experience",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A truthful visual proof of an outcome and its underlying architecture.",
  "properties": {
    "artifactRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "capabilityMaturity": {
      "$ref": "#/$defs/CapabilityMaturity",
      "default": "not_assessed"
    },
    "catalog": {
      "$ref": "#/$defs/CatalogMetadata"
    },
    "contract": {
      "const": "demo-experience/v1",
      "title": "Contract",
      "type": "string"
    },
    "evidenceRefs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidencerefs",
      "type": "array"
    },
    "failureScenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failurescenario"
    },
    "fixturePackRefs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Fixturepackrefs",
      "type": "array"
    },
    "interactionIds": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Interactionids",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "outcomePatternRefs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Outcomepatternrefs",
      "type": "array"
    },
    "publicationStatus": {
      "$ref": "#/$defs/PublicationStatus",
      "default": "draft"
    },
    "referenceArchitectureRefs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Referencearchitecturerefs",
      "type": "array"
    },
    "runEvidenceRefs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Runevidencerefs",
      "type": "array"
    },
    "storyboardSteps": {
      "items": {
        "$ref": "#/$defs/DemoStoryboardStep"
      },
      "minItems": 1,
      "title": "Storyboardsteps",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "supportStatus": {
      "$ref": "#/$defs/SupportStatus",
      "default": "evaluation_only"
    },
    "visualPatternId": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Visualpatternid",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "artifactRef",
    "catalog",
    "name",
    "summary",
    "outcomePatternRefs",
    "referenceArchitectureRefs",
    "interactionIds",
    "visualPatternId",
    "storyboardSteps"
  ],
  "title": "DemoExperience",
  "type": "object"
}
