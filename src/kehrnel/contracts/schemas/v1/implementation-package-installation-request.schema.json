{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:implementation-package-installation-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "implementation-package-installation-request/v1",
      "title": "Contract",
      "type": "string"
    },
    "installationMode": {
      "const": "tenant_sandbox",
      "default": "tenant_sandbox",
      "title": "Installationmode",
      "type": "string"
    },
    "packageRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "qualificationEvidenceRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "targetCapabilityProfileRef": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "contract",
    "packageRef",
    "qualificationEvidenceRef",
    "targetCapabilityProfileRef"
  ],
  "title": "ImplementationPackageInstallationRequest",
  "type": "object"
}
