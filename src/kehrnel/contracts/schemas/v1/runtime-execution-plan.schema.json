{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BlueprintRevisionRef": {
      "additionalProperties": false,
      "properties": {
        "blueprintId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Blueprintid",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "blueprintId",
        "revision",
        "digest"
      ],
      "title": "BlueprintRevisionRef",
      "type": "object"
    },
    "CompilationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CompilationIssue",
      "type": "object"
    },
    "InteractionBehavior": {
      "enum": [
        "create",
        "update",
        "delete",
        "command",
        "read",
        "search",
        "query",
        "subscribe",
        "publish",
        "export"
      ],
      "title": "InteractionBehavior",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "review",
        "blocking"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "RuntimeRoute": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "$ref": "#/$defs/InteractionBehavior"
        },
        "executorRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "fallbackBehavior": {
          "minLength": 1,
          "title": "Fallbackbehavior",
          "type": "string"
        },
        "interactionId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Interactionid",
          "type": "string"
        },
        "planFamilyId": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planfamilyid"
        },
        "plannerRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policyRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "routeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Routeid",
          "type": "string"
        },
        "semanticBindingRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "strategyInstanceId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Strategyinstanceid",
          "type": "string"
        }
      },
      "required": [
        "routeId",
        "interactionId",
        "behavior",
        "strategyInstanceId",
        "semanticBindingRef",
        "plannerRef",
        "executorRef",
        "fallbackBehavior"
      ],
      "title": "RuntimeRoute",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:runtime-execution-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "blueprintRef": {
      "$ref": "#/$defs/BlueprintRevisionRef"
    },
    "contract": {
      "const": "runtime-execution-plan/v1",
      "title": "Contract",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/CompilationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/RuntimeRoute"
      },
      "title": "Routes",
      "type": "array"
    },
    "targetCapabilityProfileRef": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "contract",
    "artifactRef",
    "blueprintRef",
    "targetCapabilityProfileRef"
  ],
  "title": "RuntimeExecutionPlan",
  "type": "object"
}
