  "$id": "urn:mongodb:data-lab:contracts:v1:modeler-proposal-approval-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Human review decisions for an immutable proposal.\n\nThis record still does not apply the patch, compile a strategy, persist a\nBlueprint, or activate a runtime.  A later authorized workflow must consume\nit and re-check all identities and digests.  Every proposed change is\nexplicitly approved or rejected; partial acceptance is represented by a\ndependency-closed approved set and its exact rejected complement.  Rejecting\nevery change does not require deterministic validation; approving any\nchange requires a valid receipt for exactly that selected set.",
  "properties": {
    "contract": {
      "const": "modeler-proposal-approval-request/v1",
      "title": "Contract",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ModelerPerChangeReview"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "intent": {
      "const": "record_review_decisions",
      "title": "Intent",
      "type": "string"
    },
    "proposal": {
      "$ref": "#/$defs/ModelerBlueprintProposal"
    },
    "rationale": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "reviewDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Reviewdigest",
      "type": "string"
    },
    "reviewId": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Reviewid",
      "type": "string"
    },
    "reviewer": {
      "$ref": "#/$defs/ModelerReviewerIdentity"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelerProposalValidationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract",
    "intent",
    "reviewId",
    "reviewDigest",
    "proposal",
    "reviewer",
    "decisions",
    "rationale"
  ],
  "title": "ModelerProposalApprovalRequest",
  "type": "object"
}
