{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BlueprintOverrideOperation": {
      "description": "Restricted JSON Patch operations accepted at the Builder boundary.",
      "enum": [
        "add",
        "remove",
        "replace"
      ],
      "title": "BlueprintOverrideOperation",
      "type": "string"
    },
    "BlueprintRevisionIdentity": {
      "additionalProperties": false,
      "description": "One exact immutable Blueprint revision used as proposal input.",
      "properties": {
        "blueprintId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Blueprintid",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "blueprintId",
        "revision",
        "digest"
      ],
      "title": "BlueprintRevisionIdentity",
      "type": "object"
    },
    "CompilationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CompilationIssue",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "review",
        "blocking"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "JsonValue": {},
    "ModelerAgenticDestination": {
      "additionalProperties": false,
      "description": "Exact Agentic Engine workspace selected by the hosting server.",
      "properties": {
        "deploymentId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Deploymentid",
          "type": "string"
        },
        "engine": {
          "const": "mongodb_agentic_engine",
          "title": "Engine",
          "type": "string"
        },
        "workspaceRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "engine",
        "workspaceRef",
        "deploymentId"
      ],
      "title": "ModelerAgenticDestination",
      "type": "object"
    },
    "ModelerAgenticExecutionReceipt": {
      "additionalProperties": false,
      "description": "Server-captured Agentic Engine execution identity and tool evidence.\n\nThis is a structural receipt, not a cryptographic attestation from MongoDB.\nThe host must obtain it from the configured Agentic Engine integration and\nverify every ``toolRef`` is a member of the pinned registry.",
      "properties": {
        "completedAt": {
          "format": "date-time",
          "title": "Completedat",
          "type": "string"
        },
        "contract": {
          "const": "modeler-agentic-execution-receipt/v1",
          "title": "Contract",
          "type": "string"
        },
        "engine": {
          "const": "mongodb_agentic_engine",
          "title": "Engine",
          "type": "string"
        },
        "executionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executiondigest",
          "type": "string"
        },
        "executionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Executionid",
          "type": "string"
        },
        "invocationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Invocationdigest",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Invocationid",
          "type": "string"
        },
        "modelId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Modelid",
          "type": "string"
        },
        "providerId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Providerid",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Sessionid",
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "toolReceipts": {
          "items": {
            "$ref": "#/$defs/ModelerToolReceipt"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Toolreceipts",
          "type": "array"
        },
        "toolRegistryRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "workspaceRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "contract",
        "engine",
        "executionDigest",
        "invocationId",
        "invocationDigest",
        "toolRegistryRef",
        "workspaceRef",
        "providerId",
        "modelId",
        "executionId",
        "sessionId",
        "startedAt",
        "completedAt",
        "toolReceipts"
      ],
      "title": "ModelerAgenticExecutionReceipt",
      "type": "object"
    },
    "ModelerAgenticInvocation": {
      "additionalProperties": false,
      "description": "Server-created, content-addressed authorization to call Agentic Engine.\n\nThe contract records an allowlist and policy decision but cannot prove who\ncreated them.  The host must authenticate this record and enforce tool\nmembership and data exposure before dispatch.",
      "properties": {
        "authorizedEvidenceRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 512,
          "title": "Authorizedevidencerefs",
          "type": "array"
        },
        "baseBlueprint": {
          "$ref": "#/$defs/BlueprintRevisionIdentity"
        },
        "catalogRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Catalogrefs",
          "type": "array"
        },
        "contract": {
          "const": "modeler-agentic-invocation/v1",
          "title": "Contract",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/ModelerAgenticDestination"
        },
        "exposureManifest": {
          "items": {
            "$ref": "#/$defs/ModelerExposureItem"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Exposuremanifest",
          "type": "array"
        },
        "exposureManifestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exposuremanifestdigest",
          "type": "string"
        },
        "invocationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Invocationdigest",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Invocationid",
          "type": "string"
        },
        "issuedBy": {
          "const": "data_lab_server",
          "title": "Issuedby",
          "type": "string"
        },
        "payloadDigest": {
          "description": "Digest of the exact redacted payload dispatched to Agentic Engine.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payloaddigest",
          "type": "string"
        },
        "payloadSizeBytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Payloadsizebytes",
          "type": "integer"
        },
        "policyDecision": {
          "$ref": "#/$defs/ModelerPolicyDecision"
        },
        "scope": {
          "$ref": "#/$defs/ModelerAssistantScope"
        },
        "toolRegistryRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "contract",
        "issuedBy",
        "invocationId",
        "invocationDigest",
        "createdAt",
        "scope",
        "baseBlueprint",
        "catalogRefs",
        "destination",
        "exposureManifest",
        "exposureManifestDigest",
        "policyDecision",
        "payloadDigest",
        "payloadSizeBytes",
        "toolRegistryRef"
      ],
      "title": "ModelerAgenticInvocation",
      "type": "object"
    },
    "ModelerAssistantScope": {
      "additionalProperties": false,
      "description": "Identity and authorization context injected by the hosting server.\n\nClients and the language model must not choose these values.  The\n``authorizationDigest`` lets an integration fail closed if permissions\nchange between proposal, validation, and approval.",
      "properties": {
        "actorId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Actorid",
          "type": "string"
        },
        "authorizationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authorizationdigest",
          "type": "string"
        },
        "binding": {
          "const": "server_bound",
          "title": "Binding",
          "type": "string"
        },
        "projectId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Projectid",
          "type": "string"
        },
        "purpose": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Role",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Sessionid",
          "type": "string"
        },
        "tenantId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Tenantid",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "tenantId",
        "projectId",
        "actorId",
        "sessionId",
        "role",
        "purpose",
        "authorizationDigest"
      ],
      "title": "ModelerAssistantScope",
      "type": "object"
    },
    "ModelerAssumptionOrigin": {
      "enum": [
        "declared",
        "inferred"
      ],
      "title": "ModelerAssumptionOrigin",
      "type": "string"
    },
    "ModelerBlueprintChange": {
      "additionalProperties": false,
      "description": "One explainable, non-executing Blueprint patch suggestion.\n\nValidation is delegated to :class:`BlueprintOverride`, preserving the same\nrestricted ``add``/``remove``/``replace`` operations, editable roots, JSON\nPointer rules, and canonical JSON value subset used by the Builder.",
      "properties": {
        "assumptionIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Assumptionids",
          "type": "array"
        },
        "changeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Changeid",
          "type": "string"
        },
        "confidenceBasisPoints": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Confidencebasispoints",
          "type": "integer"
        },
        "dependsOnChangeIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Dependsonchangeids",
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidenceids",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/BlueprintOverrideOperation"
        },
        "path": {
          "minLength": 1,
          "pattern": "^/(?:objective|participants|interactions|semanticAuthorities|recordAuthorityPolicies|dataPostures|constraints|targetCapabilityProfileRef|preferredFoundationRefs|assumptions|decisions)(?:/(?:[^~/]|~[01])*)*$",
          "title": "Path",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "changeId",
        "operation",
        "path",
        "rationale",
        "confidenceBasisPoints"
      ],
      "title": "ModelerBlueprintChange",
      "type": "object"
    },
    "ModelerBlueprintProposal": {
      "additionalProperties": false,
      "description": "Immutable Agentic Engine suggestion awaiting deterministic validation.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/ModelerProposalAssumption"
          },
          "maxItems": 256,
          "title": "Assumptions",
          "type": "array"
        },
        "baseBlueprint": {
          "$ref": "#/$defs/BlueprintRevisionIdentity"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ModelerBlueprintChange"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "contract": {
          "const": "modeler-blueprint-proposal/v1",
          "title": "Contract",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ModelerProposalEvidence"
          },
          "maxItems": 512,
          "title": "Evidence",
          "type": "array"
        },
        "executionReceipt": {
          "$ref": "#/$defs/ModelerAgenticExecutionReceipt"
        },
        "invocation": {
          "$ref": "#/$defs/ModelerAgenticInvocation"
        },
        "proposalDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposaldigest",
          "type": "string"
        },
        "proposalId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Proposalid",
          "type": "string"
        },
        "proposalOrigin": {
          "const": "mongodb_agentic_engine",
          "title": "Proposalorigin",
          "type": "string"
        },
        "rationale": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ModelerAssistantScope"
        },
        "status": {
          "const": "proposed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "proposalOrigin",
        "status",
        "proposalId",
        "proposalDigest",
        "scope",
        "baseBlueprint",
        "invocation",
        "executionReceipt",
        "summary",
        "rationale",
        "changes"
      ],
      "title": "ModelerBlueprintProposal",
      "type": "object"
    },
    "ModelerChangeReviewDecision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "ModelerChangeReviewDecision",
      "type": "string"
    },
    "ModelerConsentStatus": {
      "enum": [
        "not_required",
        "granted",
        "denied"
      ],
      "title": "ModelerConsentStatus",
      "type": "string"
    },
    "ModelerDataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "ModelerDataClassification",
      "type": "string"
    },
    "ModelerEvidenceKind": {
      "description": "The bounded provenance classes an assistant may cite.",
      "enum": [
        "catalog_artifact",
        "source_observation",
        "user_requirement",
        "compiler_evidence",
        "prior_decision"
      ],
      "title": "ModelerEvidenceKind",
      "type": "string"
    },
    "ModelerExposureItem": {
      "additionalProperties": false,
      "description": "One content-addressed item authorized to cross the agent boundary.",
      "properties": {
        "artifactRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification": {
          "$ref": "#/$defs/ModelerDataClassification"
        },
        "contentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contentdigest",
          "type": "string"
        },
        "exposureId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Exposureid",
          "type": "string"
        },
        "includedPaths": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Includedpaths",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ModelerExposureKind"
        },
        "purpose": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "exposureId",
        "kind",
        "classification",
        "purpose",
        "contentDigest"
      ],
      "title": "ModelerExposureItem",
      "type": "object"
    },
    "ModelerExposureKind": {
      "enum": [
        "blueprint",
        "catalog_artifact",
        "source_evidence",
        "runtime_evidence",
        "user_requirement",
        "conversation_context"
      ],
      "title": "ModelerExposureKind",
      "type": "string"
    },
    "ModelerPerChangeReview": {
      "additionalProperties": false,
      "description": "One explicit human decision for one immutable proposed change.",
      "properties": {
        "changeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Changeid",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ModelerChangeReviewDecision"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "changeId",
        "decision",
        "rationale"
      ],
      "title": "ModelerPerChangeReview",
      "type": "object"
    },
    "ModelerPolicyDecision": {
      "additionalProperties": false,
      "description": "Explicit policy and consent decision made before an invocation.",
      "properties": {
        "consentRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consentStatus": {
          "$ref": "#/$defs/ModelerConsentStatus"
        },
        "decisionRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "outcome": {
          "$ref": "#/$defs/ModelerPolicyOutcome"
        },
        "policyRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "restrictions": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Restrictions",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "policyRef",
        "decisionRef",
        "consentStatus"
      ],
      "title": "ModelerPolicyDecision",
      "type": "object"
    },
    "ModelerPolicyOutcome": {
      "enum": [
        "allow",
        "deny"
      ],
      "title": "ModelerPolicyOutcome",
      "type": "string"
    },
    "ModelerProposalAssumption": {
      "additionalProperties": false,
      "description": "A visible premise used by the assistant rather than an asserted fact.",
      "properties": {
        "assumptionId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Assumptionid",
          "type": "string"
        },
        "confidenceBasisPoints": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Confidencebasispoints",
          "type": "integer"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidenceids",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/ModelerAssumptionOrigin"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "assumptionId",
        "statement",
        "origin",
        "confidenceBasisPoints"
      ],
      "title": "ModelerProposalAssumption",
      "type": "object"
    },
    "ModelerProposalEvidence": {
      "additionalProperties": false,
      "description": "Content-addressed evidence; raw source data is intentionally excluded.",
      "properties": {
        "artifactRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contentdigest",
          "type": "string"
        },
        "evidenceId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Evidenceid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ModelerEvidenceKind"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "kind",
        "summary",
        "contentDigest"
      ],
      "title": "ModelerProposalEvidence",
      "type": "object"
    },
    "ModelerProposalValidationResult": {
      "additionalProperties": false,
      "description": "Content-addressed receipt produced only by deterministic Core.",
      "properties": {
        "baseBlueprint": {
          "$ref": "#/$defs/BlueprintRevisionIdentity"
        },
        "candidateBlueprintDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidateblueprintdigest"
        },
        "contract": {
          "const": "modeler-proposal-validation-result/v1",
          "title": "Contract",
          "type": "string"
