{
  "$id": "urn:mongodb:data-lab:contracts:v1:artifact-ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable reference to one exact artifact version and content digest.",
  "properties": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Kind",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id",
    "version",
    "digest"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
