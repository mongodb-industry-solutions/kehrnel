{
  "$id": "urn:mongodb:data-lab:contracts:v1:strategy-operational-probe-check",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkId": {
      "enum": [
        "runtime_connectivity",
        "required_collections",
        "storage_schema",
        "managed_indexes",
        "derived_projection",
        "data_freshness",
        "reconciliation_integrity"
      ],
      "title": "Checkid",
      "type": "string"
    },
    "detail": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    },
    "state": {
      "enum": [
        "passed",
        "failed",
        "unavailable"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "checkId",
    "state",
    "detail"
  ],
  "title": "StrategyOperationalProbeCheck",
  "type": "object"
}
