{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MaterializedArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifactRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source": {
          "enum": [
            "resolution",
            "build-input",
            "strategy-registry",
            "resolved-component"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "artifactRef",
        "source"
      ],
      "title": "MaterializedArtifact",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:implementation-package-materialization-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactClosureComplete": {
      "const": true,
      "default": true,
      "title": "Artifactclosurecomplete",
      "type": "boolean"
    },
    "artifactRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "contract": {
      "const": "implementation-package-materialization-receipt/v1",
      "title": "Contract",
      "type": "string"
    },
    "environmentId": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "title": "Environmentid",
      "type": "string"
    },
    "installationStageRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "materializationDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Materializationdigest",
      "type": "string"
    },
    "materializationId": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Materializationid",
      "type": "string"
    },
    "materializedArtifacts": {
      "items": {
        "$ref": "#/$defs/MaterializedArtifact"
      },
      "minItems": 1,
      "title": "Materializedartifacts",
      "type": "array"
    },
    "nextRequiredAction": {
      "const": "assess_preparation_readiness",
      "default": "assess_preparation_readiness",
      "title": "Nextrequiredaction",
      "type": "string"
    },
    "packageRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "preparationExecuted": {
      "const": false,
      "default": false,
      "title": "Preparationexecuted",
      "type": "boolean"
    },
    "runtimeExecuted": {
      "const": false,
      "default": false,
      "title": "Runtimeexecuted",
      "type": "boolean"
    },
    "state": {
      "const": "materialized",
      "default": "materialized",
      "title": "State",
      "type": "string"
    },
    "targetCapabilityProfileRef": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "contract",
    "artifactRef",
    "materializationId",
    "environmentId",
    "installationStageRef",
    "packageRef",
    "targetCapabilityProfileRef",
    "materializedArtifacts",
    "materializationDigest"
  ],
  "title": "ImplementationPackageMaterializationReceipt",
  "type": "object"
}
