  "$id": "urn:mongodb:data-lab:contracts:v1:clinical-cohort-resolution",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "clinical-cohort-resolution/v1",
      "default": "clinical-cohort-resolution/v1",
      "title": "Contract",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ResolutionDecision"
    },
    "intent": {
      "$ref": "#/$defs/ClinicalCohortIntent"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "route": {
      "$ref": "#/$defs/ResolutionRoute"
    },
    "structural": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuralBindingReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
