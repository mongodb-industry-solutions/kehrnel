    "terminology": {
      "items": {
        "$ref": "#/$defs/TerminologyGroundingReceipt"
      },
      "title": "Terminology",
      "type": "array"
    }
  },
  "required": [
    "decision",
    "intent",
    "route"
  ],
  "title": "ClinicalCohortResolution",
  "type": "object"
}
