        },
        "evidenceRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "failureScenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
