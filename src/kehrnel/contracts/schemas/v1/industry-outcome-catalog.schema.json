          "type": "string"
        }
      },
      "required": [
        "stepId",
        "title",
        "actorAction",
        "visibleResult"
      ],
      "title": "DemoStoryboardStep",
      "type": "object"
    },
    "InteractionEffect": {
      "description": "The observable effect an application, workflow, or agent may cause.",
      "enum": [
        "retrieve",
        "subscribe",
        "enrich",
        "command",
        "coordinate",
        "record_decision",
        "remember",
        "improve"
      ],
      "title": "InteractionEffect",
      "type": "string"
    },
    "InteractionRequirement": {
      "additionalProperties": false,
      "description": "What a consumer can do, not merely which protocol it can call.",
      "properties": {
        "approvalRequired": {
          "default": false,
          "title": "Approvalrequired",
          "type": "boolean"
        },
        "auditRequired": {
          "default": true,
          "title": "Auditrequired",
          "type": "boolean"
        },
        "autonomyModes": {
          "items": {
            "$ref": "#/$defs/AutonomyMode"
          },
          "minItems": 1,
          "title": "Autonomymodes",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/InteractionEffect"
        },
        "interactionId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Interactionid",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "readProductIds": {
          "items": {
            "type": "string"
          },
          "title": "Readproductids",
          "type": "array"
        },
        "writeTargets": {
          "items": {
            "$ref": "#/$defs/InteractionWriteTarget"
          },
          "title": "Writetargets",
          "type": "array"
        }
      },
      "required": [
        "interactionId",
        "name",
        "description",
        "effect",
        "autonomyModes"
      ],
      "title": "InteractionRequirement",
      "type": "object"
    },
    "InteractionWriteTarget": {
      "additionalProperties": false,
      "description": "A durable effect produced by one interaction requirement.",
      "properties": {
        "authorityRequired": {
          "default": false,
          "title": "Authorityrequired",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/WriteTargetKind"
        },
        "productId": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Productid",
          "type": "string"
        },
        "sourceOfTruth": {
          "default": false,
          "title": "Sourceoftruth",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "productId"
      ],
      "title": "InteractionWriteTarget",
      "type": "object"
    },
    "OutcomePattern": {
