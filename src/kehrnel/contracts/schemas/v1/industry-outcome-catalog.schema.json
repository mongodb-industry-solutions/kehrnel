      },
      "required": [
        "contract",
        "artifactRef",
        "catalog",
        "name",
        "summary",
        "outcomePatternRefs",
        "referenceArchitectureRefs",
        "interactionIds",
        "visualPatternId",
        "storyboardSteps"
      ],
      "title": "DemoExperience",
      "type": "object"
    },
    "DemoStoryboardStep": {
      "additionalProperties": false,
      "properties": {
        "actorAction": {
          "minLength": 1,
          "title": "Actoraction",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "stepId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Stepid",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visibleResult": {
          "minLength": 1,
