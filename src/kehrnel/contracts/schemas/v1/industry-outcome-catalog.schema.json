          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outcomePatternRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Outcomepatternrefs",
          "type": "array"
        },
        "publicationStatus": {
          "$ref": "#/$defs/PublicationStatus",
          "default": "draft"
        },
        "referenceArchitectureRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Referencearchitecturerefs",
