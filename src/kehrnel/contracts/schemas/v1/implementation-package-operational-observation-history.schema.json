{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ImplementationPackageOperationalObservationReceipt": {
      "additionalProperties": false,
      "properties": {
        "activeDeploymentRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "activePackageRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifactRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/OperationalObservationCheck"
          },
          "maxItems": 11,
          "minItems": 11,
          "title": "Checks",
          "type": "array"
        },
        "configurationDriftState": {
          "enum": [
            "in_sync",
            "drifted",
            "unavailable"
          ],
          "title": "Configurationdriftstate",
          "type": "string"
        },
        "contract": {
          "const": "implementation-package-operational-observation-receipt/v1",
          "title": "Contract",
          "type": "string"
        },
        "driftState": {
          "enum": [
            "in_sync",
            "release_changed",
            "release_absent"
          ],
          "title": "Driftstate",
          "type": "string"
        },
        "environmentId": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Environmentid",
          "type": "string"
        },
        "evidencePersistence": {
          "const": "durable",
          "default": "durable",
          "title": "Evidencepersistence",
          "type": "string"
        },
        "expectedDeploymentRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "expectedPackageRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "externalTrafficObservation": {
          "const": "not_observed",
          "title": "Externaltrafficobservation",
          "type": "string"
        },
        "healthState": {
          "enum": [
            "healthy",
            "degraded",
            "unavailable"
          ],
          "title": "Healthstate",
          "type": "string"
        },
        "monitoringOwnerRef": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Monitoringownerref",
          "type": "string"
        },
        "nextRequiredAction": {
          "enum": [
            "continue_monitoring",
            "review_release_drift",
            "deploy_release_candidate",
            "investigate_strategy_health",
            "reconcile_strategy_drift"
          ],
          "title": "Nextrequiredaction",
          "type": "string"
        },
        "observationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observationdigest",
          "type": "string"
        },
        "observationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Observationid",
          "type": "string"
        },
        "observationRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Observationrequestid",
          "type": "string"
        },
        "observationScope": {
          "const": "kehrnel_release_binding",
          "title": "Observationscope",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        },
        "observedByRef": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Observedbyref",
          "type": "string"
        },
        "strategyProbes": {
          "items": {
            "$ref": "#/$defs/StrategyOperationalProbeEvidence"
          },
          "title": "Strategyprobes",
          "type": "array"
        }
      },
      "required": [
        "contract",
        "artifactRef",
        "observationId",
        "observationRequestId",
        "environmentId",
        "expectedDeploymentRef",
        "expectedPackageRef",
        "observedByRef",
        "observedAt",
        "monitoringOwnerRef",
        "checks",
        "healthState",
        "driftState",
        "configurationDriftState",
        "observationScope",
        "externalTrafficObservation",
        "nextRequiredAction",
        "observationDigest"
      ],
      "title": "ImplementationPackageOperationalObservationReceipt",
      "type": "object"
    },
    "OperationalObservationCheck": {
      "additionalProperties": false,
      "properties": {
        "checkId": {
          "enum": [
            "active_release_present",
            "expected_deployment_active",
            "expected_package_active",
            "deployment_artifact_integrity",
            "readiness_artifact_integrity",
            "preparation_artifact_integrity",
            "runtime_evidence_integrity",
            "strategy_runtime_health",
            "schema_index_drift",
            "data_freshness",
            "reconciliation_integrity"
          ],
          "title": "Checkid",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "checkId",
        "state",
        "detail"
      ],
      "title": "OperationalObservationCheck",
      "type": "object"
    },
    "StrategyOperationalProbeCheck": {
      "additionalProperties": false,
      "properties": {
        "checkId": {
          "enum": [
            "runtime_connectivity",
            "required_collections",
            "storage_schema",
            "managed_indexes",
            "derived_projection",
            "data_freshness",
            "reconciliation_integrity"
          ],
          "title": "Checkid",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "checkId",
        "state",
        "detail"
      ],
      "title": "StrategyOperationalProbeCheck",
      "type": "object"
    },
    "StrategyOperationalProbeEvidence": {
      "additionalProperties": false,
      "properties": {
        "activationSpecificationRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/StrategyOperationalProbeCheck"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Checks",
          "type": "array"
        },
        "contract": {
          "const": "strategy-operational-probe-evidence/v1",
          "title": "Contract",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "evidenceDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidencedigest",
          "type": "string"
        },
        "freshnessTargetSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshnesstargetseconds"
        },
        "indexState": {
          "enum": [
            "in_sync",
            "drifted",
            "unavailable"
          ],
          "title": "Indexstate",
          "type": "string"
        },
        "observedFreshnessSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observedfreshnessseconds"
        },
        "probeOperation": {
          "const": "operational_probe",
          "default": "operational_probe",
          "title": "Probeoperation",
          "type": "string"
        },
        "reconciliationDivergenceCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciliationdivergencecount"
        },
        "runtimeActivationId": {
          "minLength": 1,
          "title": "Runtimeactivationid",
          "type": "string"
        },
        "schemaState": {
          "enum": [
            "in_sync",
            "drifted",
            "unavailable"
          ],
          "title": "Schemastate",
          "type": "string"
        },
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "strategyInstanceId": {
          "minLength": 1,
          "title": "Strategyinstanceid",
          "type": "string"
        },
        "strategyRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "contract",
        "strategyInstanceId",
        "strategyRef",
        "activationSpecificationRef",
        "runtimeActivationId",
        "domain",
        "state",
        "schemaState",
        "indexState",
        "checks",
        "evidenceDigest"
      ],
      "title": "StrategyOperationalProbeEvidence",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:implementation-package-operational-observation-history",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded, newest-first observation history for one exact deployment.",
  "properties": {
    "configurationTrend": {
      "enum": [
        "insufficient_history",
        "unchanged",
        "improved",
        "degraded"
      ],
      "title": "Configurationtrend",
      "type": "string"
    },
    "contract": {
      "const": "implementation-package-operational-observation-history/v1",
      "title": "Contract",
      "type": "string"
    },
    "environmentId": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "title": "Environmentid",
      "type": "string"
    },
    "expectedDeploymentRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "expectedPackageRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "healthTrend": {
      "enum": [
        "insufficient_history",
        "unchanged",
        "improved",
        "degraded"
      ],
      "title": "Healthtrend",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ImplementationPackageOperationalObservationReceipt"
      },
      "maxItems": 50,
      "title": "Observations",
      "type": "array"
    },
    "returnedCount": {
      "maximum": 50,
      "minimum": 0,
      "title": "Returnedcount",
      "type": "integer"
    },
    "totalCount": {
      "minimum": 0,
      "title": "Totalcount",
      "type": "integer"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "contract",
    "environmentId",
    "expectedDeploymentRef",
    "expectedPackageRef",
    "observations",
    "totalCount",
    "returnedCount",
    "truncated",
    "healthTrend",
    "configurationTrend"
  ],
  "title": "ImplementationPackageOperationalObservationHistory",
  "type": "object"
}
