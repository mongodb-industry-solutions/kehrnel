{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:implementation-package-rollback-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "const": "approved",
      "title": "Approval",
      "type": "string"
    },
    "contract": {
      "const": "implementation-package-rollback-request/v1",
      "title": "Contract",
      "type": "string"
    },
    "deploymentRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "executedByRef": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Executedbyref",
      "type": "string"
    },
    "expectedPackageRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "rollbackRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Rollbackrequestid",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "rollbackRequestId",
    "deploymentRef",
    "expectedPackageRef",
    "executedByRef",
    "approval",
    "reason"
  ],
  "title": "ImplementationPackageRollbackRequest",
  "type": "object"
}
