{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:implementation-package-operational-observation-trigger-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic monitoring slot invoked by an external scheduler.",
  "properties": {
    "contract": {
      "const": "implementation-package-operational-observation-trigger-request/v1",
      "title": "Contract",
      "type": "string"
    },
    "expectedDeploymentRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "expectedPackageRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "observedByRef": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Observedbyref",
      "type": "string"
    },
    "scheduleId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Scheduleid",
      "type": "string"
    },
    "scheduledFor": {
      "format": "date-time",
      "title": "Scheduledfor",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "scheduleId",
    "expectedDeploymentRef",
    "expectedPackageRef",
    "observedByRef",
    "scheduledFor"
  ],
  "title": "ImplementationPackageOperationalObservationTriggerRequest",
  "type": "object"
}
