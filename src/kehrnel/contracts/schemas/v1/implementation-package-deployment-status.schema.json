{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "urn:mongodb:data-lab:contracts:v1:implementation-package-deployment-status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activeDeploymentRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "activePackageRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "activeReadinessRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract": {
      "const": "implementation-package-deployment-status/v1",
      "title": "Contract",
      "type": "string"
    },
    "environmentId": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "title": "Environmentid",
      "type": "string"
    },
    "nextRequiredAction": {
      "enum": [
        "monitor_or_rollback",
        "deploy_ready_release_candidate"
      ],
      "title": "Nextrequiredaction",
      "type": "string"
    },
    "state": {
      "enum": [
        "active",
        "none"
      ],
      "title": "State",
      "type": "string"
    },
    "trafficManagement": {
      "const": "external",
      "default": "external",
      "title": "Trafficmanagement",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "environmentId",
    "state",
    "nextRequiredAction"
  ],
  "title": "ImplementationPackageDeploymentStatus",
  "type": "object"
}
