{
  "$defs": {
    "AcknowledgementLevel": {
      "enum": [
        "accepted",
        "durable_authoritative",
        "derived_visible"
      ],
      "title": "AcknowledgementLevel",
      "type": "string"
    },
    "ArchitectureConstraints": {
      "additionalProperties": false,
      "properties": {
        "estimatedDocuments": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimateddocuments"
        },
        "peakReadsPerSecond": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peakreadspersecond"
        },
        "peakWritesPerSecond": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peakwritespersecond"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "retentionDays": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retentiondays"
        },
        "tenancyMode": {
          "default": "single_tenant",
          "enum": [
            "single_tenant",
            "multi_tenant"
          ],
          "title": "Tenancymode",
          "type": "string"
        }
      },
      "title": "ArchitectureConstraints",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one exact artifact version and content digest.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AuthorityScope": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "lifecycleStates": {
          "items": {
            "type": "string"
          },
          "title": "Lifecyclestates",
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "recordTypes": {
          "items": {
            "type": "string"
          },
          "title": "Recordtypes",
          "type": "array"
        },
        "scopeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Scopeid",
          "type": "string"
        }
      },
      "required": [
        "scopeId",
        "domain"
      ],
      "title": "AuthorityScope",
      "type": "object"
    },
    "BlueprintOverrideOperation": {
      "description": "Restricted JSON Patch operations accepted at the Builder boundary.",
      "enum": [
        "add",
        "remove",
        "replace"
      ],
      "title": "BlueprintOverrideOperation",
      "type": "string"
    },
    "BlueprintRevisionIdentity": {
      "additionalProperties": false,
      "description": "One exact immutable Blueprint revision used as proposal input.",
      "properties": {
        "blueprintId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Blueprintid",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "blueprintId",
        "revision",
        "digest"
      ],
      "title": "BlueprintRevisionIdentity",
      "type": "object"
    },
    "ConsistencyRequirement": {
      "enum": [
        "strong",
        "bounded_staleness",
        "eventual",
        "snapshot"
      ],
      "title": "ConsistencyRequirement",
      "type": "string"
    },
    "DataPostureSelection": {
      "additionalProperties": false,
      "properties": {
        "posture": {
          "$ref": "#/$defs/IntegrationPosture"
        },
        "scopeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Scopeid",
          "type": "string"
        },
        "servingRepositoryRef": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Servingrepositoryref"
        }
      },
      "required": [
        "scopeId",
        "posture"
      ],
      "title": "DataPostureSelection",
      "type": "object"
    },
    "DataProductComposition": {
      "additionalProperties": false,
      "description": "Explicit lineage between semantic data-product scopes.\n\nThis is separate from SemanticMode.COMPOSED: that mode governs meaning;\nthis contract names the products supplying another product's data.",
      "properties": {
        "compositionId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Compositionid",
          "type": "string"
        },
        "inputScopeIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputscopeids",
          "type": "array"
        },
        "targetScopeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Targetscopeid",
          "type": "string"
        }
      },
      "required": [
        "compositionId",
        "targetScopeId",
        "inputScopeIds"
      ],
      "title": "DataProductComposition",
      "type": "object"
    },
    "IntegrationPosture": {
      "description": "How much responsibility MongoDB assumes for one source domain.",
      "enum": [
        "federated_access",
        "selective_materialization",
        "operational_replica",
        "mongodb_system_of_record"
      ],
      "title": "IntegrationPosture",
      "type": "string"
    },
    "InteractionBehavior": {
      "enum": [
        "create",
        "update",
        "delete",
        "command",
        "read",
        "search",
        "query",
        "subscribe",
        "publish",
        "export"
      ],
      "title": "InteractionBehavior",
      "type": "string"
    },
    "InteractionGuarantees": {
      "additionalProperties": false,
      "properties": {
        "acknowledgement": {
          "$ref": "#/$defs/AcknowledgementLevel",
          "default": "accepted"
        },
        "consistency": {
          "$ref": "#/$defs/ConsistencyRequirement",
          "default": "strong"
        },
        "freshnessTargetSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshnesstargetseconds"
        },
        "idempotencyRequired": {
          "default": false,
          "title": "Idempotencyrequired",
          "type": "boolean"
        },
        "latencyTargetMs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latencytargetms"
        }
      },
      "title": "InteractionGuarantees",
      "type": "object"
    },
    "InteractionInterface": {
      "additionalProperties": false,
      "properties": {
        "capabilityRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/InterfaceKind"
        },
        "protocolVersion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocolversion"
        }
      },
      "required": [
        "kind"
      ],
      "title": "InteractionInterface",
      "type": "object"
    },
    "InteractionPattern": {
      "enum": [
        "request_response",
        "publish_subscribe",
        "stream",
        "batch"
      ],
      "title": "InteractionPattern",
      "type": "string"
    },
    "InteractionRoleBindings": {
      "additionalProperties": false,
      "properties": {
        "providerRef": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerref"
        },
        "publisherRef": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisherref"
        },
        "requesterRef": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requesterref"
        },
        "subscriberRef": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscriberref"
        }
      },
      "title": "InteractionRoleBindings",
      "type": "object"
    },
    "InterfaceKind": {
      "enum": [
        "rest",
        "fhir",
        "openehr",
        "aql",
        "mql",
        "sql",
        "event",
        "agent_tool",
        "natural_language"
      ],
      "title": "InterfaceKind",
      "type": "string"
    },
    "JsonValue": {},
    "ModelerAgenticDestination": {
      "additionalProperties": false,
      "description": "Exact Agentic Engine workspace selected by the hosting server.",
      "properties": {
        "deploymentId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Deploymentid",
          "type": "string"
        },
        "engine": {
          "const": "mongodb_agentic_engine",
          "title": "Engine",
          "type": "string"
        },
        "workspaceRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "engine",
        "workspaceRef",
        "deploymentId"
      ],
      "title": "ModelerAgenticDestination",
      "type": "object"
    },
    "ModelerAgenticExecutionReceipt": {
      "additionalProperties": false,
      "description": "Server-captured Agentic Engine execution identity and tool evidence.\n\nThis is a structural receipt, not a cryptographic attestation from MongoDB.\nThe host must obtain it from the configured Agentic Engine integration and\nverify every ``toolRef`` is a member of the pinned registry.",
      "properties": {
        "completedAt": {
          "format": "date-time",
          "title": "Completedat",
          "type": "string"
        },
        "contract": {
          "const": "modeler-agentic-execution-receipt/v1",
          "title": "Contract",
          "type": "string"
        },
        "engine": {
          "const": "mongodb_agentic_engine",
          "title": "Engine",
          "type": "string"
        },
        "executionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executiondigest",
          "type": "string"
        },
        "executionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Executionid",
          "type": "string"
        },
        "invocationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Invocationdigest",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Invocationid",
          "type": "string"
        },
        "modelId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Modelid",
          "type": "string"
        },
        "providerId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Providerid",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Sessionid",
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "toolReceipts": {
          "items": {
            "$ref": "#/$defs/ModelerToolReceipt"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Toolreceipts",
          "type": "array"
        },
        "toolRegistryRef": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "workspaceRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "contract",
        "engine",
        "executionDigest",
        "invocationId",
        "invocationDigest",
        "toolRegistryRef",
        "workspaceRef",
        "providerId",
        "modelId",
        "executionId",
        "sessionId",
        "startedAt",
        "completedAt",
        "toolReceipts"
      ],
      "title": "ModelerAgenticExecutionReceipt",
      "type": "object"
    },
    "ModelerAgenticInvocation": {
      "additionalProperties": false,
      "description": "Server-created, content-addressed authorization to call Agentic Engine.\n\nThe contract records an allowlist and policy decision but cannot prove who\ncreated them.  The host must authenticate this record and enforce tool\nmembership and data exposure before dispatch.",
      "properties": {
        "authorizedEvidenceRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 512,
          "title": "Authorizedevidencerefs",
          "type": "array"
        },
        "baseBlueprint": {
          "$ref": "#/$defs/BlueprintRevisionIdentity"
        },
        "catalogRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Catalogrefs",
          "type": "array"
        },
        "contract": {
          "const": "modeler-agentic-invocation/v1",
          "title": "Contract",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/ModelerAgenticDestination"
        },
        "exposureManifest": {
          "items": {
            "$ref": "#/$defs/ModelerExposureItem"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Exposuremanifest",
          "type": "array"
        },
        "exposureManifestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Exposuremanifestdigest",
          "type": "string"
        },
        "invocationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Invocationdigest",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Invocationid",
          "type": "string"
        },
        "issuedBy": {
          "const": "data_lab_server",
          "title": "Issuedby",
          "type": "string"
        },
        "payloadDigest": {
          "description": "Digest of the exact redacted payload dispatched to Agentic Engine.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payloaddigest",
          "type": "string"
        },
        "payloadSizeBytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Payloadsizebytes",
          "type": "integer"
        },
        "policyDecision": {
          "$ref": "#/$defs/ModelerPolicyDecision"
        },
        "scope": {
          "$ref": "#/$defs/ModelerAssistantScope"
        },
        "toolRegistryRef": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "contract",
        "issuedBy",
        "invocationId",
        "invocationDigest",
        "createdAt",
        "scope",
        "baseBlueprint",
        "catalogRefs",
        "destination",
        "exposureManifest",
        "exposureManifestDigest",
        "policyDecision",
        "payloadDigest",
        "payloadSizeBytes",
        "toolRegistryRef"
      ],
      "title": "ModelerAgenticInvocation",
      "type": "object"
    },
    "ModelerAssistantScope": {
      "additionalProperties": false,
      "description": "Identity and authorization context injected by the hosting server.\n\nClients and the language model must not choose these values.  The\n``authorizationDigest`` lets an integration fail closed if permissions\nchange between proposal, validation, and approval.",
      "properties": {
        "actorId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Actorid",
          "type": "string"
        },
        "authorizationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authorizationdigest",
          "type": "string"
        },
        "binding": {
          "const": "server_bound",
          "title": "Binding",
          "type": "string"
        },
        "projectId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Projectid",
          "type": "string"
        },
        "purpose": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Role",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Sessionid",
          "type": "string"
        },
        "tenantId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Tenantid",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "tenantId",
        "projectId",
        "actorId",
        "sessionId",
        "role",
        "purpose",
        "authorizationDigest"
      ],
      "title": "ModelerAssistantScope",
      "type": "object"
    },
    "ModelerAssumptionOrigin": {
      "enum": [
        "declared",
        "inferred"
      ],
      "title": "ModelerAssumptionOrigin",
      "type": "string"
    },
    "ModelerBlueprintChange": {
      "additionalProperties": false,
      "description": "One explainable, non-executing Blueprint patch suggestion.\n\nValidation is delegated to :class:`BlueprintOverride`, preserving the same\nrestricted ``add``/``remove``/``replace`` operations, editable roots, JSON\nPointer rules, and canonical JSON value subset used by the Builder.",
      "properties": {
        "assumptionIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Assumptionids",
          "type": "array"
        },
        "changeId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Changeid",
          "type": "string"
        },
        "confidenceBasisPoints": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Confidencebasispoints",
          "type": "integer"
        },
        "dependsOnChangeIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Dependsonchangeids",
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidenceids",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/BlueprintOverrideOperation"
        },
        "path": {
          "minLength": 1,
          "pattern": "^/(?:objective|participants|interactions|semanticAuthorities|recordAuthorityPolicies|dataPostures|constraints|targetCapabilityProfileRef|preferredFoundationRefs|assumptions|decisions)(?:/(?:[^~/]|~[01])*)*$",
          "title": "Path",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "changeId",
        "operation",
        "path",
        "rationale",
        "confidenceBasisPoints"
      ],
      "title": "ModelerBlueprintChange",
      "type": "object"
    },
    "ModelerBlueprintProposal": {
      "additionalProperties": false,
      "description": "Immutable Agentic Engine suggestion awaiting deterministic validation.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/ModelerProposalAssumption"
          },
          "maxItems": 256,
          "title": "Assumptions",
          "type": "array"
        },
        "baseBlueprint": {
          "$ref": "#/$defs/BlueprintRevisionIdentity"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ModelerBlueprintChange"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "contract": {
          "const": "modeler-blueprint-proposal/v1",
          "title": "Contract",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ModelerProposalEvidence"
          },
          "maxItems": 512,
          "title": "Evidence",
          "type": "array"
        },
        "executionReceipt": {
          "$ref": "#/$defs/ModelerAgenticExecutionReceipt"
        },
        "invocation": {
          "$ref": "#/$defs/ModelerAgenticInvocation"
        },
        "proposalDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposaldigest",
          "type": "string"
        },
        "proposalId": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Proposalid",
          "type": "string"
        },
        "proposalOrigin": {
          "const": "mongodb_agentic_engine",
          "title": "Proposalorigin",
          "type": "string"
        },
        "rationale": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Rationale",
