# All-in-one Kehrnel image (core + FHIR). For API-only or FHIR-only images see docker/.
FROM python:3.12-slim
WORKDIR /kehrnel
COPY pyproject.toml README.md ./
COPY src ./src
COPY src/kehrnel/engine/domains/fhir/libs ./src/kehrnel/engine/domains/fhir/libs
RUN pip install --no-cache-dir -e ".[all]"
ENV API_PORT=8080
ENV KEHRNEL_API_PORT=8080
ENV KEHRNEL_API_RELOAD=false
CMD ["kehrnel-api"]
EXPOSE 8080
