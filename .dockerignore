# Ignore node_modules and dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ignore build/test/Next.js output
/.next/
/out/
/build/
/coverage/

# Ignore misc and debug files
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore Vercel
.vercel/

# Ignore TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Ignore deployment/config files
policy.json
task-def.json
Makefile

# Ignore CI/CD and legal files
.drone.yml
LICENSE
THIRD-PARTY-NOTICES.md
third-party-licenses.json

# Ignore README and other docs files
README.md

# Ignore other folders not needed for build
/data/
/environments/
/scripts/

# Keep vendored FHIR libs for FHIR images (docker/Dockerfile.kehrnel-fhir, Dockerfile.backend)
# Exclude local venvs inside vendored trees
/src/kehrnel/engine/domains/fhir/libs/**/.venv/
/src/kehrnel/engine/domains/fhir/libs/**/venv/
/src/kehrnel/engine/domains/fhir/libs/**/__pycache__/